generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id          Int      @id @default(autoincrement())
  title       String
  location    String
  price       Int
  type        String
  status      String
  bedrooms    Int
  bathrooms   Int
  area        Int
  featured    Boolean  @default(false)
  image       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id
  email     String?  @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}